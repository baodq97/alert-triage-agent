# LLM provider — any OpenAI-compatible endpoint (OpenAI, DeepSeek, Ollama, vLLM, OpenRouter...)
LLM_API_KEY=your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Agent guardrails
MAX_STEPS=15

# Memory store base dir (entity-keyed L1/L2 atoms; defaults to .memory when unset)
MEMORY_DIR=.memory

# L3 posture synthesis cadence: regenerate the org-level threat posture brief every
# N completed runs. 0 = disabled (never synthesise automatically; use
# --synthesize-posture for on-demand regeneration). Counts are tracked in
# .memory/_run_count across process restarts.
MEMORY_SYNTHESIZE_EVERY_N_RUNS=0

# Risk Policy file location (defaults to config/risk_policy.yaml when unset)
RISK_POLICY_PATH=config/risk_policy.yaml

# Threat Intel delegated agent (RFC-0002 / US-0005).
# Absent-by-default: set to "true", "1", or "yes" to enable IOC enrichment.
# When disabled (the default), the primary loop completes unchanged — zero TI
# code paths are executed, and existing replay caches stay valid.
TI_ENABLED=false
